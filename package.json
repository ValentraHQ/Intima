{
  "name": "intima",
  "private": true,
  "description": "INTIMA platform monorepo",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10.28"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint",
    "stack:up": "bash infrastructure/docker/init-env.sh && docker compose -f infrastructure/docker/compose.yaml --env-file infrastructure/docker/.env up -d --wait --wait-timeout 180",
    "stack:down": "docker compose -f infrastructure/docker/compose.yaml --env-file infrastructure/docker/.env down",
    "stack:reset": "docker compose -f infrastructure/docker/compose.yaml --env-file infrastructure/docker/.env down -v --remove-orphans && node infrastructure/docker/clean-generated.mjs",
    "stack:ps": "docker compose -f infrastructure/docker/compose.yaml --env-file infrastructure/docker/.env ps",
    "stack:env": "bash infrastructure/docker/init-env.sh",
    "stack:verify-rabbitmq": "node infrastructure/docker/verify-rabbitmq-persistence.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@intima/config": "workspace:*",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "typescript": "~5.9.3"
  }
}
